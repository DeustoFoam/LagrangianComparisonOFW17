{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      physicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

continuousPhaseName   air;
transportModel        Newtonian;

rho   [1 -3 0 0 0 0 0] 1.661;     //air 1.205   Ar 1.661    kg/m^3 @NTP (1atm, 20ºC)
nu    [0 2 -1 0 0 0 0] 1.385e-05; //air 1.82e-5 Ar 1.385e-5 m^2/s  @NTP (1atm, 20ºC)

