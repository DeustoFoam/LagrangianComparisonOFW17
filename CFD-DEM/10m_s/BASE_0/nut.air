FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 5.8e-5;

boundaryField
{
    inlet
    {
        type            calculated;
        value           uniform 5.8e-5;
    }
    outlet
    {
        type            calculated;
        value           uniform 0;
    }
    wall
    {
        type            nutkWallFunction;
        /*Cmu             0.09;
        kappa           0.41;
        E               9.8;*/
        value           uniform 5.8e-5;
    }
}


// ************************************************************************* //
