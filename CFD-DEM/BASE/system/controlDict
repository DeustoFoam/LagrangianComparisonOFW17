FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "$FOAM_CASE/constant/variables"

application     denseParticleFoam;

startFrom       latestTime;

stopAt          endTime;

endTime         $varEndTime;

deltaT          $varDeltaT;

adjustTimeStep  false;

maxCo           0.75;

writeControl    adjustableRunTime; //timeStep;

writeInterval   $varWriteInt;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

functions
{
    #includeFunc  residuals
    
    #includeFunc  graphUniform
    
    pointProbe1
    {
        type            probes;
        functionObjectLibs ("libsampling.so");
        writeControl   timeStep;
        writeInterval  1;
        probeLocations  (
                          (0 0 0)
                          (0 0 0.03)
                        );
        fields          (p);
    }
}

